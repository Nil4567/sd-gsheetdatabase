      <div class="form-group"><label>Customer Contact</label><input type="text" id="customerContact"></div>
      <div class="form-group"><label>Job Description *</label><input type="text" id="jobDescription" required></div>
      <div class="form-group"><label>Total Amount</label><input type="number" id="totalAmount">
